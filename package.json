    "src",
    "core/*.py",
    "core/*.json",
    "core/*.csv",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "ai",
    "coding",
    "usage",
    "tokens",
    "claude-code",
    "codex",
    "antigravity",
    "productivity",
    "quota"
  ],
  "dependencies": {
    "@json-render/core": "0.22.0",
    "@json-render/ink": "0.22.0",
    "ink": "^6.0.0",
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "license": "MIT"
}
