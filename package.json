{
  "name": "worthit",
  "version": "0.16.0",
  "description": "Is your AI coding plan worth it? One command prices every request in your local Claude Code, Codex and Antigravity logs at API rates: what a weekly limit is really worth, cost per model and per merged PR, unused allowance, open vs closed models. Local, no account.",
  "type": "module",
  "bin": {
    "worthit": "bin/worthit.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "core/*.py",
    "core/*.json",
    "core/*.csv",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "ai-coding",
    "claude-code",
    "claude",
    "anthropic",
    "codex",
    "openai",
    "antigravity",
    "gemini",
    "token-usage",
    "usage-tracker",
    "llm-cost",
    "cost-tracking",
    "rate-limits",
    "quota",
    "subscription",
    "developer-productivity",
    "coding-agents",
    "cli",
    "tui",
    "local-first"
  ],
  "dependencies": {
    "@json-render/core": "0.22.0",
    "@json-render/ink": "0.22.0",
    "ink": "^6.0.0",
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namastex888/worthit.git"
  },
  "homepage": "https://github.com/namastex888/worthit#readme",
  "bugs": {
    "url": "https://github.com/namastex888/worthit/issues"
  }
}
