{
  "name": "worthit",
  "version": "0.1.0",
  "description": "What your AI coding subscription is really worth: a local, one-command AI coding productivity meter for Claude Code, Codex and Antigravity.",
  "type": "module",
  "bin": {
    "worthit": "bin/worthit.mjs",
    "usagemeter": "bin/worthit.mjs"
  },
  "files": [
